{
  "name": "qurOS",
  "short_name": "qurOS",
  "description": "Capture your days and brain-dumps — talk with the screen locked, then send it all to your knowledge base.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e0e0e",
  "theme_color": "#0e0e0e",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Talk", "short_name": "Talk", "description": "Open ready to talk", "url": "./?go=talk", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Write", "short_name": "Write", "description": "Write a dump", "url": "./?go=write", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Day", "short_name": "Day", "description": "Log the day", "url": "./?go=day", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
